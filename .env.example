# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure Configuration
# ------------------------------------------------------------------------------
# URL of your Supabase project instance (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key for browser-side and server-side authenticated queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# (Optional) Service Role Key - REQUIRED ONLY for privileged administrative tasks,
# backend webhooks, and automated background jobs bypassing Row Level Security (RLS).
# NEVER expose this key to client-side code or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Canonical Site & Deployment Telemetry
# ------------------------------------------------------------------------------
# Canonical base URL of the MRO platform used for generating Open Graph tags,
# Highwire Press citation schemas, and absolute DOI resolution links.
# Development: http://localhost:9000
# Production: https://maniresearch.org
NEXT_PUBLIC_SITE_URL=https://maniresearch.org
